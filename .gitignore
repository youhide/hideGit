# --- Rust ---------------------------------------------------------------
/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS tracked. hideGit ships a binary, so a reproducible
# dependency graph is part of the release artifact.
# See: https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control-but-not-libraries

# --- Local agent notes --------------------------------------------------
# Personal, untracked context for AI assistants. See CLAUDE.md.
CLAUDE.local.md
# Per-machine tool permissions. Only the `.local` file is ignored, so a shared
# `.claude/settings.json` remains trackable if the project ever wants one.
/.claude/settings.local.json

# --- Local configuration ------------------------------------------------
.env
.env.local
*.local.toml

# --- Editors / IDEs -----------------------------------------------------
/.idea/
/.vscode/*
!/.vscode/extensions.json
*.swp
*.swo
*~

# --- Operating system ---------------------------------------------------
.DS_Store
.AppleDouble
Thumbs.db
desktop.ini

# --- Build & packaging output -------------------------------------------
/dist/
/release/
*.dmg
*.msi
*.AppImage
*.flatpak
